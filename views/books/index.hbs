<section class="page">
  <div class="page-head">
    <h1>Book list</h1>
    <a class="btn" href="/books/create">+ Add book</a>
  </div>

  <p class="hint">
    Data is loaded with the <code>user_read_23IT005</code> account.
    Session visit count (stored on Atlas): <strong>{{visitCount}}</strong>
  </p>

  {{#if books.length}}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Product code</th>
          <th>Title</th>
          <th>Author</th>
          <th>Price</th>
          <th>Price after VAT ({{vatPercent}}%)</th>
        </tr>
      </thead>
      <tbody>
        {{#each books}}
        <tr>
          <td>{{code}}</td>
          <td>{{title}}</td>
          <td>{{author}}</td>
          <td>{{formatMoney price}} VND</td>
          <td>{{formatMoney priceAfterVAT}} VND</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="empty">No books yet. Add one with a code starting with {{productPrefix}}.</p>
  {{/if}}
</section>
